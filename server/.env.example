# ============================================================================
# CCMS — Server Environment Configuration Template
# Copy to server/.env and fill in with your real credentials.
# ============================================================================

# ─── Server & Network Configuration ──────────────────────────────────────────
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:5000
USE_HTTPS=false

# ─── Security & Authentication ────────────────────────────────────────────────
JWT_SECRET=your-strong-random-jwt-secret-here
SUPER_ADMIN_KEY=your-super-admin-passcode-here

# ─── Supabase Cloud Integration ───────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Operation Mode & Offline Sync ────────────────────────────────────────────
OFFLINE_MODE=true
OVERTIME_RATE_MULTIPLIER=1.0

# ─── Localization & Timezone ──────────────────────────────────────────────────
REPORT_TIMEZONE=Africa/Cairo
